## Algoritmo Rabin Karp (Checollo Alberth)
#include <stdio.h>
#include <string.h>

void rabin_karp_demostracion(const char *T, const char *P, int b, int q) {
    int n = strlen(T), m = strlen(P);
    long long hp = 1, hP = 0, hT = 0;
    int i, s, j; // Declarada la variable 'j' aqui para C89

    int total_evaluaciones_hash = 0;
    int total_comparaciones_caracter = 0;
    int colisiones = 0;

    // 1. Precalcular hp = b^(m-1) mod q y hashes iniciales (s = 0)
    for (i = 0; i < m - 1; i++) hp = (hp * b) % q;
    for (i = 0; i < m; i++) {
        hP = (hP * b + (unsigned char)P[i]) % q;
        hT = (hT * b + (unsigned char)T[i]) % q;
    }

    // Encabezado de la demostracion
    printf("=========================================================================================\n");
    printf("                  DEMOSTRACION COMPLETA: ALGORITMO RABIN-KARP                            \n");
    printf("=========================================================================================\n");
    printf(" Texto (T)  : %s (n = %d) | Patron (P) : %s (m = %d)\n", T, n, P, m);
    printf(" Base (b)   : %d | Modulo (q) : %d | Hash Objetivo h(P) : %lld\n", b, q, hP);
    printf(" Constante hp = b^(m-1) mod q : %lld\n", hp);
    printf("=========================================================================================\n");
    printf("  s  | Ventana | Hash h(T) | Filtro Hash | Verificacion Caracteres | Estado / Resultado \n");
    printf("-----+---------+-----------+-------------+-------------------------+---------------------\n");

    for (s = 0; s <= n - m; s++) {
        total_evaluaciones_hash++;

        printf(" %2d  |  %.*s   |    %3lld    | ", s, m, T + s, hT);

        // 2. Evaluacion mediante Rabin-Karp
        if (hP == hT) {
            printf(" COINCIDE   | ");
            
            // Verificaci n explicita caracter por caracter
            int coincide_exacto = 1;
            int comp_ventana = 0;

            for (j = 0; j < m; j++) {
                comp_ventana++;
                if (T[s + j] != P[j]) {
                    coincide_exacto = 0;
                    break;
                }
            }
            total_comparaciones_caracter += comp_ventana;

            if (coincide_exacto) {
                printf("%d comps. -> IGUALES   | [!] COINCIDENCIA EXACTA\n", comp_ventana);
            } else {
                colisiones++;
                printf("%d comps. -> DISTINTOS| [?] FALSO POSITIVO\n", comp_ventana);
            }
        } else {
            // El hash descarto la ventana en O(1) sin comparar letras
            printf(" DIFERENTE  | 0 comparaciones (O(1))  | --- (Descartado)\n");
        }

        // 3. Actualizar el hash rodante para la siguiente ventana
        if (s < n - m) {
            unsigned char saliente = T[s];
            unsigned char entrante = T[s + m];
            hT = (b * (hT - saliente * hp) + entrante) % q;
            if (hT < 0) hT = (hT + q) % q;
        }
    }

    // Resumen de rendimiento para la exposicion
    printf("=========================================================================================\n");
    printf(" RESUMEN DE EJECUCION DE RABIN-KARP:\n");
    printf(" -> Evaluaciones de Hash realizadas       : %d (1 por ventana usando Rolling Hash)\n", total_evaluaciones_hash);
    printf(" -> Comparaciones reales de caracteres    : %d (solo en coincidencias de hash)\n", total_comparaciones_caracter);
    printf(" -> Colisiones / Falsos Positivos         : %d\n", colisiones);
    printf(" -> Comparaciones ahorradas vs Fuerza Bruta: %d comparaciones evitadas\n", (n - m + 1) * m - total_comparaciones_caracter);
    printf("=========================================================================================\n");
}

int main() {
    char T[] = "AABAACAADAABAABA";
    char P[] = "AABA";

    rabin_karp_demostracion(T, P, 256, 101);

    return 0;
}


