## Prefijo y sufijo (Checollo Alberth)
#include <stdio.h>
#include <string.h>

void calcularTablaLPS(char* P, int m, int lps[]) {
    int len = 0;
    lps[0] = 0;
    int i = 1;

    while (i < m) {
        if (P[i] == P[len]) {
            len++;
            lps[i] = len;
            i++;
        } else {
            if (len != 0) {
                len = lps[len - 1];
            } else {
                lps[i] = 0;
                i++;
            }
        }
    }
}

int main() {
    char P[] = "ABABACA";
    int m = strlen(P);
    int lps[m];

    calcularTablaLPS(P, m, lps);

    printf("Patron (P) : %s (m = %d) | Alfabeto Base : {'A', 'B', 'C'}\n", P, m);
    printf("========================================================================================\n");
    printf("j  | Caracter P[j] | Subcadena P[0...j]  | Borde Mas Largo (LPS) | Longitud lps[j]\n");
    printf("---+---------------+---------------------+-----------------------+-----------------\n");

    char sub[20];
    for (int j = 0; j < m; j++) {
        // Copiar subcadena P[0...j]
        strncpy(sub, P, j + 1);
        sub[j + 1] = '\0';

        // Determinar descripciones textuales del borde mas largo para la traza
        char* borde_str = "NO EX";
        if (lps[j] == 1) borde_str = "A";
        else if (lps[j] == 2) borde_str = "AB";
        else if (lps[j] == 3) borde_str = "ABA";

        printf("%-2d | %-13c | %-19s | %-21s | %-15d\n", j, P[j], sub, borde_str, lps[j]);
    }

    printf("========================================================================================\n");
    printf("RESUMEN DE CONSTRUCCION DE LA TABLA LPS:\n");
    printf("-> Arreglo LPS resultante   : [");
    for (int j = 0; j < m; j++) {
        printf("%d%s", lps[j], (j == m - 1) ? "" : ", ");
    }
    printf("]\n");
    printf("-> Operaciones de analisis  : Acotadas estrictamente a O(m) mediante amortizacion de bordes.\n");

    return 0;
}


