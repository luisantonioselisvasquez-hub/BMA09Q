## Algoritmo KMP (Palpa Marco)
#include <stdio.h>
#include <string.h>

void construir_lps(const char *patron, int m, int lps[]) {
    int j=0;
    lps[0] = 0;

    for (int i = 1; i < m; i++) {

        while (j > 0 && patron[i] != patron[j]) {
            j = lps[j - 1];
        }

        if (patron[i] == patron[j]) {
            j++;
        }

        lps[i] = j;
    }
}

void kmp_string_matching(const char *texto, const char *patron) {
    int n = strlen(texto);
    int m = strlen(patron);

    int lps[m];
    int i = 0;
    int j = 0;

    int total_comparaciones = 0;
    int total_mismatches = 0;

    construir_lps(patron, m, lps);

    printf("Texto  T: \"%s\" (n = %d)\n", texto, n);
    printf("Patron P: \"%s\" (m = %d)\n\n", patron, m);

    printf("Tabla LPS: [");
    for (int k = 0; k < m; k++) {
        printf("%d%s", lps[k], (k < m - 1) ? ", " : "");
    }
    printf("]\n\n");

    printf("- RESULTADOS -\n");

    while (i < n) {

        total_comparaciones++;

        if (texto[i] == patron[j]) {
            i++;
            j++;

            if (j == m) {
                printf("COINCIDENCIA ENCONTRADA Posicion inicial: %d\n",
                       i - j);

                j = lps[j - 1];
            }

        } else {
            total_mismatches++;

            if (j > 0) {
                j = lps[j - 1];
            } else {
                i++;
            }
        }
    }

    printf("\n- RESUMEN DE RESULTADOS \n");
    printf("Total de comparaciones de caracteres: %d\n",
           total_comparaciones);
    printf("Total de mismatches registrados: %d\n",
           total_mismatches);
}

int main() {

    const char *texto_ejemplo = "AABAACAADAABAABA";
    const char *patron_ejemplo = "AABA";

    kmp_string_matching(texto_ejemplo, patron_ejemplo);

    return 0;
}

