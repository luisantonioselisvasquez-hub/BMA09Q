## Algortimo de busqueda ingenua (Palpa Marco)
#include <stdio.h>
#include <string.h>
void naive_string_matching_con_metricas(const char *texto, const char *patron) {
    int n = strlen(texto);
    int m = strlen(patron);
    
    int desplazamientos_validos[100];
    int num_validos = 0;
    int total_comparaciones = 0;
    int total_mismatches = 0;

    printf("Texto  (T): \"%s\" (n = %d)\n", texto, n);
    printf("Patron (P): \"%s\" (m = %d)\n\n", patron, m);
    printf("--- TRAZA PASO A PASO ---\n");
    
    // Recorrido de los desplazamientos s en el rango [0, n - m]
    for (int s = 0; s <= n - m; s++) {
        int j = 0;
        int comparaciones_s = 0;
        
        while (j < m && texto[s + j] == patron[j]) {
            j++;
            comparaciones_s++;
        }
        
        // Si el bucle se interrumpió antes de completar el patrón
        if (j < m) {
            comparaciones_s++; // Se suma la comparación que provocó el mismatch
            total_mismatches++;
            printf("Desplazamiento s = %2d: Mismatch en T[%d] ('%c') != P[%d] ('%c') tras %d comp.\n", 
                   s, s + j, texto[s + j], j, patron[j], comparaciones_s);
        } else {
            desplazamientos_validos[num_validos++] = s;
            printf("Desplazamiento s = %2d: COINCIDENCIA ENCONTRADA (%d comp.)\n", s, comparaciones_s);
        }
        
        total_comparaciones += comparaciones_s;
    }

    printf("\nRESUMEN DE RESULTADOS\n");
    printf("Desplazamientos validos encontrados (s): [");
    for (int k = 0; k < num_validos; k++) {
        printf("%d%s", desplazamientos_validos[k], (k < num_validos - 1) ? ", " : "");
    }
    printf("]\n");
    printf("Total de comparaciones de caracteres: %d\n", total_comparaciones);
    printf("Total de mismatches registrados: %d\n", total_mismatches);
    printf("Promedio de comparaciones por desplazamiento: %.2f\n", (float)total_comparaciones / (n - m + 1));
}

int main() {
    const char *texto_ejemplo = "AABAACAADAABAABA";
    const char *patron_ejemplo = "AABA";

    naive_string_matching_con_metricas(texto_ejemplo, patron_ejemplo);

    return 0;
}


