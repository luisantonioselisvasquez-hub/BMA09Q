## Funcion Hash (Checollo Alberth)
#include <stdio.h>
#include <string.h>

void comparacion_tabla_completa(const char *T, const char *P, int b, int q) {
    int n = strlen(T), m = strlen(P);
    long long hp = 1, hP = 0, hT_movil = 0;
    int i, s;

    int total_pasos_tradicional = 0;
    int total_pasos_rodante = 0;

    // 1. Precalcular hp = b^(m-1) mod q y hash del patron
    for (i = 0; i < m - 1; i++) hp = (hp * b) % q;
    for (i = 0; i < m; i++) {
        hP = (hP * b + (unsigned char)P[i]) % q;
        hT_movil = (hT_movil * b + (unsigned char)T[i]) % q;
    }

    // Encabezado principal de la demostración
    printf("=========================================================================================\n");
    printf("              DEMOSTRACION COMPARATIVA: HASH TRADICIONAL VS HASH RODANTE                \n");
    printf("=========================================================================================\n");
    printf(" Texto (T)  : %s (n = %d) | Patron (P) : %s (m = %d)\n", T, n, P, m);
    printf(" Base (b)   : %d | Modulo (q) : %d | Hash Patron h(P) : %lld\n", b, q, hP);
    printf("=========================================================================================\n");
    printf("  s  | Ventana | Hash | Estado / Resultado                | Pasos Trad. | Pasos Rodante  \n");
    printf("-----+---------+------+-----------------------------------+-------------+----------------\n");

    for (s = 0; s <= n - m; s++) {
        // --- HASH TRADICIONAL ---
        // Vuelve a recorrer los m caracteres en CADA iteracion
        long long hT_trad = 0;
        int pasos_trad = 0;
        for (i = 0; i < m; i++) {
            hT_trad = (hT_trad * b + (unsigned char)T[s + i]) % q;
            pasos_trad++;
        }
        total_pasos_tradicional += pasos_trad;

        // --- HASH RODANTE ---
        int pasos_rodante = (s == 0) ? m : 1; // Solo s=0 lee m caracteres, luego es O(1)
        total_pasos_rodante += pasos_rodante;

        // Impresion de la fila completa
        printf(" %2d  |  %.*s   |  %2lld  | ", s, m, T + s, hT_movil);

        if (hP == hT_movil) {
            if (strncmp(T + s, P, m) == 0) {
                printf("[!] COINCIDENCIA EXACTA ENCONTRADA  | ");
            } else {
                printf("[?] Colision de Hash (Falso Pos.)  | ");
            }
        } else {
            printf("--- (No coincide)                   | ");
        }

        printf("  %d letras   |   %d operacion\n", pasos_trad, pasos_rodante);

        // Actualizar el hash rodante para la siguiente ventana
        if (s < n - m) {
            unsigned char saliente = T[s];
            unsigned char entrante = T[s + m];
            hT_movil = (b * (hT_movil - saliente * hp) + entrante) % q;
            if (hT_movil < 0) hT_movil = (hT_movil + q) % q;
        }
    }

    printf("=========================================================================================\n");
    printf(" RESUMEN TOTAL DE OPERACIONES MATEMATICAS:\n");
    printf(" -> Hash Tradicional (Recalculo completo) : %d pasos acumulados (O(n * m))\n", total_pasos_tradicional);
    printf(" -> Hash Rodante     (Rolling Hash O(1))  : %d pasos acumulados (O(n + m))\n", total_pasos_rodante);
    printf("=========================================================================================\n");
}

int main() {
    char T[] = "AABAACAADAABAABA";
    char P[] = "AABA";

    comparacion_tabla_completa(T, P, 256, 101);

    return 0;
}
