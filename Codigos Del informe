#include <stdio.h>
#include <stdlib.h>
 
typedef struct Nodo {
    int dest;
    struct Nodo *sig;
} Nodo;
 
typedef struct {
    int V, E;
    Nodo **ady;
} Grafo;
 
Grafo *crearGrafo(int V) {
    Grafo *g = (Grafo *)malloc(sizeof(Grafo));
    g->V = V;
    g->E = 0;
    g->ady = (Nodo **)calloc(V, sizeof(Nodo *));
    return g;
}
 
void agregarArista(Grafo *g, int u, int v) {      // dirigida u -> v
    Nodo *n = (Nodo *)malloc(sizeof(Nodo));
    n->dest = v;
    n->sig = NULL;
    if (!g->ady[u]) g->ady[u] = n;
    else {
        Nodo *p = g->ady[u];
        while (p->sig) p = p->sig;
        p->sig = n;
    }
    g->E++;
}
 
void liberar(Grafo *g) {
    for (int i = 0; i < g->V; i++) {
        Nodo *p = g->ady[i];
        while (p) { Nodo *t = p; p = p->sig; free(t); }
    }
    free(g->ady);
    free(g);
}
 
/* Devuelve 1 si encuentra back edge; guarda la arista en (*bu, *bv) */
static int dfsCiclo(Grafo *g, int u, int *color, int *bu, int *bv) {
    color[u] = 1;                                   /* gris */
    for (Nodo *p = g->ady[u]; p; p = p->sig) {
        int v = p->dest;
        if (color[v] == 1) {                        /* back edge */
            *bu = u;
            *bv = v;
            return 1;
        }
        if (color[v] == 0 && dfsCiclo(g, v, color, bu, bv))
            return 1;
    }
    color[u] = 2;                                   /* negro */
    return 0;
}
 
void probarCiclo(Grafo *g, const char *titulo, const char *aristas) {
    int *color = (int *)calloc(g->V, sizeof(int));
    int bu = -1, bv = -1, hay = 0;
 
    printf("%s\n", titulo);
    printf("Aristas: E = %s\n", aristas);
 
    for (int u = 0; u < g->V && !hay; u++)
        if (color[u] == 0) hay = dfsCiclo(g, u, color, &bu, &bv);
 
    if (hay) {
        printf("Back edge encontrada: (%d,%d)\n", bu, bv);
        printf("¡ALERTA! Ciclo detectado mediante arista hacia atras (Back Edge).\n");
    } else {
        printf("El grafo NO contiene ciclos.\n");
    }
    printf("\n");
    free(color);
}
 
int main(void) {
    printf("=== Prueba 2: Deteccion de Ciclos ===\n\n");
 
    /* Caso A: DAG */
    Grafo *a = crearGrafo(3);
    agregarArista(a, 0, 1);
    agregarArista(a, 1, 2);
    agregarArista(a, 0, 2);
    probarCiclo(a, "Caso A (Grafo Aciclico - DAG)", "{(0,1), (1,2), (0,2)}");
    liberar(a);
 
    /* Caso B: cíclico */
    Grafo *b = crearGrafo(3);
    agregarArista(b, 0, 1);
    agregarArista(b, 1, 2);
    agregarArista(b, 2, 0);
    probarCiclo(b, "Caso B (Grafo Ciclico)", "{(0,1), (1,2), (2,0)}");
    liberar(b);
 
    return 0;
}
