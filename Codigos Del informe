#include <stdio.h>
#include <stdlib.h>

#define BLANCO 0
#define GRIS   1
#define NEGRO  2

typedef struct NodoLista {
    int destino;
    struct NodoLista *sig;
} NodoLista;

typedef struct {
    int V;
    NodoLista **A;
} GrafoLista;

GrafoLista *crearGrafo(int V) {
    GrafoLista *g = (GrafoLista *)malloc(sizeof(GrafoLista));
    if (!g) return NULL;
    g->V = V;
    g->A = (NodoLista**)calloc(V, sizeof(NodoLista *));
    if (!g->A) { free(g); return NULL; }
    return g;
}

int agregarAristaDirigida(GrafoLista *g, int u, int v) {
    NodoLista *nuevo = (NodoLista *)malloc(sizeof(NodoLista));
    if (!nuevo) return 0;
    nuevo->destino = v;
    nuevo->sig = g->A[u];
    g->A[u] = nuevo;
    return 1;
}

void liberarGrafo(GrafoLista *g) {
    for (int i = 0; i < g->V; i++) {
        NodoLista *p = g->A[i];
        while (p) { NodoLista *t = p; p = p->sig; free(t); }
    }
    free(g->A);
    free(g);
}

/* DFS con coloreo: devuelve 1 si encuentra una arista hacia atrás (ciclo) */
int dfsCiclo(const GrafoLista *g, int u, int estado[]) {
    estado[u] = GRIS;                          /* u está en la pila de llamadas */
    for (NodoLista *p = g->A[u]; p != NULL; p = p->sig) {
        int v = p->destino;
        if (estado[v] == GRIS) return 1;       /* back edge => ciclo */
        if (estado[v] == BLANCO && dfsCiclo(g, v, estado)) return 1;
    }
    estado[u] = NEGRO;                         /* u completamente procesado */
    return 0;
}

int tieneCicloDFS(const GrafoLista *g) {
    int *estado = (int *)calloc(g->V, sizeof(int));
    if (!estado) return -1;
    int ciclo = 0;
    for (int i = 0; i < g->V && !ciclo; i++)
        if (estado[i] == BLANCO)
            ciclo = dfsCiclo(g, i, estado);
    free(estado);
    return ciclo;
}

int main(void) {
    /* Caso DAG: 0->1, 0->2, 1->3, 2->3, 3->4 */
    GrafoLista *dag = crearGrafo(5);
    agregarAristaDirigida(dag, 0, 1);
    agregarAristaDirigida(dag, 0, 2);
    agregarAristaDirigida(dag, 1, 3);
    agregarAristaDirigida(dag, 2, 3);
    agregarAristaDirigida(dag, 3, 4);
    printf("DAG:      %s\n", tieneCicloDFS(dag) ? "CICLO detectado" : "Sin ciclos");

    /* Caso cíclico: 0->1, 1->2, 2->0, 2->3 */
    GrafoLista *cic = crearGrafo(4);
    agregarAristaDirigida(cic, 0, 1);
    agregarAristaDirigida(cic, 1, 2);
    agregarAristaDirigida(cic, 2, 0);
    agregarAristaDirigida(cic, 2, 3);
    printf("Ciclico:  %s\n", tieneCicloDFS(cic) ? "CICLO detectado" : "Sin ciclos");

    liberarGrafo(dag);
    liberarGrafo(cic);
    return 0;
}
Prueba 1: Recorrido BFS y DFS en Grafo No Dirigido---------------------------------------
#include <stdio.h>
#include <stdlib.h>

#define N 5

typedef struct Nodo {
    int v;
    struct Nodo *sig;
} Nodo;

Nodo *adj[N];
int visitado[N];
int iter_aristas = 0;   /* cuenta las iteraciones del bucle de aristas */

/* Inserta v al final de la lista de u (conserva el orden de inserción) */
void agregar_dirigida(int u, int v) {
    Nodo *nuevo = (Nodo*)malloc(sizeof(Nodo)); // Se añade el cast explícito (Nodo*) para Dev-C++
    nuevo->v = v;
    nuevo->sig = NULL;
    if (adj[u] == NULL) {
        adj[u] = nuevo;
    } else {
        Nodo *p = adj[u];
        while (p->sig) p = p->sig;
        p->sig = nuevo;
    }
}

void agregar_arista(int u, int v) {   /* grafo no dirigido */
    agregar_dirigida(u, v);
    agregar_dirigida(v, u);
}

void bfs(int origen) {
    int cola[N], ini = 0, fin = 0;
    visitado[origen] = 1;
    cola[fin++] = origen;

    while (ini < fin) {
        int u = cola[ini++];
        printf("%d ", u);
        for (Nodo *p = adj[u]; p != NULL; p = p->sig) {   // bucle de aristas
            iter_aristas++;
            if (!visitado[p->v]) {
                visitado[p->v] = 1;
                cola[fin++] = p->v;
            }
        }
    }
}

void dfs(int u) {
    visitado[u] = 1;
    printf("%d ", u);
    for (Nodo *p = adj[u]; p != NULL; p = p->sig) {       // bucle de aristas
        iter_aristas++;
        if (!visitado[p->v])
            dfs(p->v);
    }
}

void reiniciar(void) {
    for (int i = 0; i < N; i++) visitado[i] = 0;
    iter_aristas = 0;
}

int main(void) {
    agregar_arista(0, 1);
    agregar_arista(0, 2);
    agregar_arista(1, 3);
    agregar_arista(2, 4);

    reiniciar();
    printf("BFS desde 0: ");
    bfs(0);
    printf("\nIteraciones del bucle de aristas: %d (2|E| = 8)\n\n", iter_aristas);

    reiniciar();
    printf("DFS desde 0: ");
    dfs(0);
    printf("\nIteraciones del bucle de aristas: %d (2|E| = 8)\n", iter_aristas);

    return 0;
}
