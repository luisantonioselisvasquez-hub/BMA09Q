// DFS
void DFS_Recursivo(GrafoLista* g, int v, bool visitado[]) {
    // 1. Marcar el nodo actual como visitado e imprimirlo
    visitado[v] = true;
    printf("%d ", v);

    // 2. Para cada nodo vecino adyacente a v:
    NodoLista* actual = g->listas[v];
    while (actual != NULL) {
        int vecino = actual->destino;

        // Si visitado[vecino] es FALSO, invocar recursivamente DFS(vecino)
        if (!visitado[vecino]) {
            DFS_Recursivo(g, vecino, visitado); 
        }
        actual = actual->siguiente;
    }
    // 3. Al finalizar la iteración, retorna automáticamente al nivel anterior (Backtracking)
}

void DFS(GrafoLista* g, int inicio) {
    // Reserva dinámica del arreglo auxiliar de estados
    bool* visitado = (bool*)calloc(g->numVertices, sizeof(bool));
    
    printf("\nRecorrido DFS desde v%crtice %d: ", 130, inicio);
    
    // Invocar la función recursiva
    DFS_Recursivo(g, inicio, visitado);
    
    printf("\n");
    free(visitado); // Liberar memoria del arreglo
}

