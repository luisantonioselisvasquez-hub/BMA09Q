void liberarGrafoLista(GrafoLista* grafo) {
    for (int i = 0; i < grafo->numVertices; i++) {
        NodoLista* actual = grafo->listas[i];
        while (actual != NULL) {
            NodoLista* temporal = actual;
            actual = actual->siguiente;
            free(temporal);
        }
    }
    free(grafo->listas);
    free(grafo);
}

// BFS
void BFS(GrafoLista* g, int inicio) {
    bool* visitado = (bool*)calloc(g->numVertices, sizeof(bool));
    Cola* q = crearCola();

    printf("\nRecorrido BFS desde v%crtice %d: ", 130, inicio);

    // Marcar origen e insertar en la cola
    visitado[inicio] = true;
    encolar(q, inicio);

    while (!colaVacia(q)) {
        int u = desencolar(q);
        printf("%d ", u); 

        NodoLista* actual = g->listas[u];
        while (actual != NULL) {
            int v = actual->destino;
            if (!visitado[v]) {
                visitado[v] = true;
                encolar(q, v);
            }
            actual = actual->siguiente;
        }
    }
    printf("\n");

    liberarCola(q);
    free(visitado);
}


